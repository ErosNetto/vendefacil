{
  "expo": {
    "name": "VendeFácil",
    "slug": "vendefacil",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vendefacil",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.com.vendefacil.app",
      "adaptiveIcon": {
        "backgroundColor": "#087F5B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.vendefacil.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087F5B"
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O VendeFácil precisa acessar a câmera para ler códigos de barras e fotografar produtos."
        }
      ]
    ]
  }
}
