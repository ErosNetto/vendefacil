{
  "expo": {
    "name": "VendeFácil",
    "slug": "vendefacil",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vendefacil",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#087F5B"
    },
    "android": {
      "package": "br.com.vendefacil.app",
      "adaptiveIcon": {
        "backgroundColor": "#087F5B"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.vendefacil.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
